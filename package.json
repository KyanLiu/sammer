{
  "name": "sammer",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -b && pnpm --filter @sammer/web build",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -b && pnpm --filter @sammer/web check",
    "start:server": "pnpm --filter @sammer/server start",
    "publish:image": "bash scripts/publish.sh",
    "dev:web": "pnpm --filter @sammer/web dev"
  },
  "devDependencies": {
    "@sammer/cli": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.7.0"
  }
}
